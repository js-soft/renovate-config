{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default configuration for all repositories",
  "extends": [
    "config:best-practices",
    "schedule:earlyMondays",
    "group:allNonMajor",
    ":automergePr",
    ":automergeDigest",
    ":automergePatch",
    ":automergeMinor"
  ],
  "labels": ["dependencies"],
  "semanticCommitType": "chore",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["js-soft/github-actions/.github/workflows/release-dependency-updates.yml"],
      "pinDigestsss": false
    }
  ]
}
