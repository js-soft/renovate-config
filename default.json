{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default configuration for all repositories",
  "schedule": ["* 0-6 * * 3"],
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    ":automergePr",
    ":automergeDigest",
    ":automergePatch",
    ":automergeMinor",
    ":semanticCommitTypeAll(chore)"
  ],
  "labels": ["dependencies"],
  "prHourlyLimit": 10,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["js-soft/github-actions/**"],
      "pinDigests": false
    }
  ]
}
